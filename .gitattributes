# 줄바꿈 LF 통일
* text=auto eol=lf

# Windows 스크립트는 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 바이너리
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.mov binary
*.webm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.jks binary
*.keystore binary
